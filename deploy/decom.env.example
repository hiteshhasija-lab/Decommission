# /etc/decom/decom.env — settings for the decommission orchestrator. Root-only (chmod 600).
# install.sh creates it with DATABASE_URL and DECOM_API_TOKEN generated; fill in the rest, then
#   systemctl restart decom-app

# --- generated by install.sh ---
DATABASE_URL=
DECOM_API_TOKEN=

# --- safety ---
# Dry run (default true): every step except the VM delete; the VM is powered back on at the end.
DECOM_DRY_RUN=true
DECOM_SOAK_HOURS=24
DECOM_POLL_SECONDS=60
DECOM_SHUTDOWN_TIMEOUT_SECONDS=180
# Never decommissioned, comma-separated (DECOM, this VM, is always included).
DECOM_NEVER_TOUCH=
# Who may request (empty = anyone) and who may confirm a delete (empty = nobody). Names as typed in --as.
DECOM_REQUESTERS=
DECOM_CONFIRMERS=
DECOM_REQUESTER_MAY_CONFIRM=false

# --- ServiceNow (integration user; its time zone must be GMT) ---
SN_INSTANCE=
SN_USER=
SN_PASSWORD=
SN_CI_CLASS=cmdb_ci_vmware_instance
SN_HOST_CLASS=cmdb_ci_esx_server
# Optional: assignment group name for the decommission changes.
SN_ASSIGNMENT_GROUP=

# --- vSphere ---
# esxi: connect to the host the CMDB names for each VM; vcenter: one vCenter (VSPHERE_URL) for all.
VSPHERE_MODE=esxi
VSPHERE_URL=
VSPHERE_USER=
VSPHERE_PASSWORD=
# Lab hosts use self-signed certificates. Leave false in production and trust the CA instead.
VSPHERE_INSECURE=false
# Optional: only these host IPs may be touched (comma-separated).
VSPHERE_ALLOWED_HOSTS=

# --- Teams ---
# console (messages kept for `decom log`) or teams-workflow (post to a Workflows webhook URL).
DECOM_NOTIFIER=console
TEAMS_WORKFLOW_URL=

# --- stuck-run alert (decom health, /healthz "stuck", and one chat message per stuck run) ---
# A working step (checking, shutting down, deleting...) longer than this many minutes:
DECOM_STUCK_MINUTES=30
# Waiting for approval, pre-checks or the delete confirmation longer than this many hours:
DECOM_STUCK_WAIT_HOURS=72
# Waiting for a person after a failed step longer than this many hours:
DECOM_STUCK_ATTENTION_HOURS=24
