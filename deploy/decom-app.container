# The orchestrator. Its API listens on 127.0.0.1:8080 only (the `decom` command); publish it through a
# reverse proxy when Teams needs to reach it.
[Unit]
Description=Decommission orchestrator
Requires=decom-postgres.service
After=decom-postgres.service

[Container]
ContainerName=decom-app
Image=localhost/decom-orchestrator:current
Network=decom.network
EnvironmentFile=/etc/decom/decom.env
PublishPort=127.0.0.1:8080:8080
HealthCmd=node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
